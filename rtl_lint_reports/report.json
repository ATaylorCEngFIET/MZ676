    "UF006": {
      "title": "Unregistered module output",
      "topic": "Register-Data-Paths-at-Logical-Boundaries",
      "url": "https://docs.amd.com/r/en-US/ug949-vivado-design-methodology/Register-Data-Paths-at-Logical-Boundaries",
      "why": "UG949 recommends registering outputs at logical boundaries to keep timing paths local and easier to analyze.",
      "action": "For a timing-sensitive boundary, move output combinational logic before an existing output register or add an output register. Keep a deliberate combinational adapter unchanged when latency must remain zero, and document that decision with a targeted waiver.",
      "verify": "Align data, valid and sideband signals. For ready/valid or AXI interfaces use a protocol-correct register slice or skid-buffer design; never delay ready/valid independently. Check latency in simulation.",
      "example": "-- Example for a simple synchronous datapath, not an AXI slice.\nprocess(clk)\nbegin\n  if rising_edge(clk) then\n    result_q <= result_comb;\n  end if;\nend process;\nresult_out <= result_q;",
      "examples": {
        "VHDL": "-- Example for a simple synchronous datapath, not an AXI slice.\nprocess(clk)\nbegin\n  if rising_edge(clk) then\n    result_q <= result_comb;\n  end if;\nend process;\nresult_out <= result_q;",
        "Verilog / SystemVerilog": "// Simple datapath example; not an AXI register slice.\nalways @(posedge clk) result_q <= result_comb;\nassign result_out = result_q;"
      }
    },
    "UF007": {
      "title": "Raw input used before capture",
      "topic": "Register-Data-Paths-at-Logical-Boundaries",
      "url": "https://docs.amd.com/r/en-US/ug949-vivado-design-methodology/Register-Data-Paths-at-Logical-Boundaries",
      "why": "UG949 suggests considering registered inputs as well as outputs at hierarchical boundaries.",
      "action": "If the interface permits an added cycle, capture the synchronous input into a local register and route its internal consumers through that register. Remove unintended raw-input bypasses. A combinational pass-through or monitor may intentionally remain unregistered.",
      "verify": "A single input register is not a CDC solution. Preserve handshake and sideband alignment; confirm latency and stall behavior before changing the boundary.",
      "example": "-- Example for a same-clock data input with one-cycle latency.\nprocess(clk)\nbegin\n  if rising_edge(clk) then\n    input_q <= input_data;\n  end if;\nend process;\n-- Use input_q in downstream logic; review any input_data bypass.",
      "examples": {
        "VHDL": "-- Example for a same-clock data input with one-cycle latency.\nprocess(clk)\nbegin\n  if rising_edge(clk) then\n    input_q <= input_data;\n  end if;\nend process;\n-- Use input_q in downstream logic; review any input_data bypass.",
        "Verilog / SystemVerilog": "// Same-clock input; adds a cycle of latency.\nalways @(posedge clk) input_q <= input_data;\n// Use input_q downstream; review raw input_data bypasses."
